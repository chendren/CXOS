  "budgets": { "sessionUsd": 5, "specUsd": 2, "warnAt": 0.8, "hardStop": true },
  "permissions": { "mode": "default", "allowBash": ["git status", "pnpm test"], "denyBash": ["rm -rf"] },
  "steering": { "importCompat": true, "warnTokens": 2000 }
}
